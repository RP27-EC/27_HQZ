# ============================================================
#  Keil MDK 编译产物（不需要进版本库）
# ============================================================

# --- 单个源文件编译出的目标文件与依赖 ---
*.o
*.d
*.crf
*.tra
*.dep
*.__i

# --- 链接阶段产物 ---
*.lnp
*.sct
*.map

# --- 可执行文件与烧录镜像 ---
*.axf
*.elf
*.hex
*.bin

# --- 编译日志与报告 ---
*.build_log.htm
*.htm
*.lst
*.plg
*.log

# --- 调试相关 ---
*.iex
*.cdb
*.uvguix.*
*.uvgui.*

# --- 备份文件 ---
*.bak
*.uvproj.bak
*~

# --- 编译输出目录 ---
Objects/
Listings/
RTE/
_build/
Debug/
Release/

# ============================================================
#  板卡 / 调试器运行时文件
# ============================================================
JLinkLog.txt
JLinkSettings.ini
*.ini

# ============================================================
#  编辑器 / 工具状态目录
# ============================================================
.vscode/
.idea/
.embeddedskills/
*.swp
